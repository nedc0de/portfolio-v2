# Images rarely change: let browsers keep them for a day without re-checking,
# and keep showing the saved copy for up to a week while a fresh one loads.
# (If an image is replaced under the same name, visitors get it within a day.)
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Security for every page:
# - other sites can't show nedcode.com inside a frame (stops clickjacking)
# - browsers don't guess file types, and only send the site name (not the
#   full page address) when you follow a link elsewhere
# - always HTTPS; no camera, mic or location access from the site
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
